+            chains += [[v, [(xf0, float(v))]] for k, v in enumerate(ys) if k not in took and OUTER_START[0] < v < OUTER_START[1]]
+        chains = [c[1] for c in chains if len(c[1]) >= MIN_CHAIN_ROWS]
+        return max(chains, key=len) if chains else []
